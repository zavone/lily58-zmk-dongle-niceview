            , <&key_physical_attrs 100 100  449  420       0     0     0>
            , <&key_physical_attrs 100 150  549  370    3000   549   520>
            , <&key_physical_attrs 100 150  851  370 (-3000)   951   520>
            , <&key_physical_attrs 100 100  951  420       0     0     0>
            , <&key_physical_attrs 100 100 1051  408       0     0     0>
            , <&key_physical_attrs 100 100 1151  408       0     0     0>
            ;
    };
